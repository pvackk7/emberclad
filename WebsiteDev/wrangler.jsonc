// Cloudflare Worker for emberclad.org: static site in website/ plus the leaderboard API in worker/index.js.
{
  "name": "emberclad",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./website",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/play/Build/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "emberclad-leaderboard",
      "database_id": "464940ea-499f-4fcd-8abe-bdae0dddc3d3"
    }
  ]
}
